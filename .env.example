# Copy to .env and fill in. Never commit .env.
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
# Secret VALUE (not the secret ID) from Certificates & secrets
CLIENT_SECRET=

# Optional: pre-fills the From field
DEFAULT_SENDER=

# Optional: comma-separated mailboxes the app may send as. Empty = any mailbox the app is permitted to use.
ALLOWED_SENDERS=

# Optional
# PORT=3000
# HOST=127.0.0.1
